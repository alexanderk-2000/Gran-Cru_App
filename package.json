{
  "name": "grand-cru-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "cd server && npm run dev",
    "start": "concurrently \"npm run dev\" \"npm run server\" \"npm run db:watch\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs,.cjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:push": "supabase db push",
    "db:push:remote": "./scripts/supabase-migrate-remote.sh",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:seed": "supabase db seed",
    "db:watch": "node scripts/watch_migrations.js",
    "baseline:data": "node scripts/baseline-data-quality.mjs",
    "baseline:ai-mapping": "node scripts/baseline-ai-mapping.mjs",
    "baseline:sources-ratings": "node scripts/baseline-sources-ratings.mjs",
    "baseline:all": "npm run baseline:data && npm run baseline:ai-mapping && npm run baseline:sources-ratings",
    "baseline:ui": "playwright test tests/ui-baseline.spec.ts",
    "test:ui": "playwright test",
    "test:ui:pwa": "playwright test tests/pwa.offline.spec.ts tests/pwa.sync.spec.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "ci:check": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "dexie": "^4.3.0",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "supabase": "^2.109.1",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10"
  }
}
