# ============================================
# BACKEND API SERVER - LOCAL DEVELOPMENT ONLY
# ============================================
# Copy this file to server/.env.local (NOT server/.env: the Firebase CLI
# deploys server/.env as plain function config, which would clash with the
# OPENROUTER_API_KEY secret). NEVER commit it to git!
#
# In production the key is a Cloud Functions secret:
#   npx firebase functions:secrets:set OPENROUTER_API_KEY

# Every AI connection (Gemini, GPT, Nemotron) goes through OpenRouter's
# single API. Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Firebase project used to verify the caller's ID token before any
# /api/ai/* route runs (see src/middleware/requireAuth.js).
FIREBASE_PROJECT_ID=your-project-id
# When running against the emulator suite instead:
# FIREBASE_PROJECT_ID=demo-gran-cru
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Rate limiting for the AI endpoints (per user, sliding window)
AI_RATE_LIMIT_WINDOW_MS=300000
AI_RATE_LIMIT_MAX_REQUESTS=30

# Sent as HTTP-Referer/X-Title to OpenRouter (used for their dashboard/rate-limit attribution)
APP_URL=http://localhost:3000
APP_NAME=Grand Cru Vault

# Server Configuration
PORT=3001
