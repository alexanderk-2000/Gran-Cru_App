# ============================================
# BACKEND API SERVER ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# AI Provider API Keys
# Get Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Get OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Get an OpenRouter API key from: https://openrouter.ai/keys
# Used for the Nemotron models (nvidia/llama-3.1-nemotron-70b-instruct etc.)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Supabase (Server-side)
# SUPABASE_URL/SUPABASE_ANON_KEY are required to verify the caller's session
# before any /api/ai/* route runs (see src/middleware/requireAuth.js). Use
# the anon key here, not the service role key - verifying a user's own JWT
# does not need elevated privileges.
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Rate limiting for the AI endpoints (per user, sliding window)
AI_RATE_LIMIT_WINDOW_MS=300000
AI_RATE_LIMIT_MAX_REQUESTS=30

# Sent as HTTP-Referer/X-Title to OpenRouter (used for their dashboard/rate-limit attribution)
APP_URL=http://localhost:3000
APP_NAME=Grand Cru Vault

# Server Configuration
PORT=3001
