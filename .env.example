# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your values
# (Firebase Console → Projekteinstellungen → Allgemein → Ihre Apps → Web-App).
# These values are public by design - access is enforced by
# firestore.rules / storage.rules, not by keeping them secret.

VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Local development against the Firebase Emulator Suite
# (npm run emulators) instead of the real project:
# VITE_FIREBASE_USE_EMULATOR=true

# App Metadata (Optional)
VITE_APP_NAME="Wine Time Capsule 2044"

# ============================================
# NOTE: AI API Keys are NOT needed in frontend!
# Locally they live in server/.env.local, in production in the
# OPENROUTER_API_KEY Cloud Functions secret.
# ============================================
