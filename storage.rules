rules_version = '2';

// Wine photos: users/{uid}/wine-images/{wineId}/{slot}. Only the owner may
// read or write; uploads must be images of at most 5 MB (the app compresses
// to ~1200px WebP before upload, so real files are far smaller).
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/wine-images/{wineId}/{slot} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
